        "output": {
          "code": "def get_primes(n):\n    sieve = [True] * (n * 15)  # Heuristic upper bound for n-th prime\n    primes = []\n    for p in range(2, len(sieve)):\n        if sieve[p]:\n            primes.append(p)\n            if len(primes) == n:\n                return primes\n            for i in range(p * p, len(sieve), p):\n                sieve[i] = False\n    return primes\n\nprint(sum(get_primes(67432)))",
          "rationale": "Uses a Sieve of Eratosthenes to find the first 67,432 primes and calculates their sum."
